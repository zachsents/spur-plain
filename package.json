{
  "name": "spur-plain",
  "version": "0.1.0",
  "private": true,
  "description": "plain's native macOS apps, Tasks, Images and Recorder, as a Switch spur.",
  "license": "MIT",
  "repository": "github:zachsents/spur-plain",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "apps": "cargo xtask install tasks && cargo xtask install images && cargo xtask install recorder",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --write .",
    "fix": "bun run lint && bun run format",
    "rust": "cargo clippy --workspace --quiet -- -D warnings",
    "check": "bun run typecheck && bun run fix && bun run rust"
  },
  "dependencies": {
    "effect": "^4.1.5",
    "spur-kit": "github:zachsents/spur-kit#b6096f7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "ultracite": "^8.3.1"
  },
  "spur": {
    "name": "plain",
    "main": "src/main.ts",
    "needs": [
      "macos"
    ],
    "widgets": [
      "tasks"
    ]
  }
}
